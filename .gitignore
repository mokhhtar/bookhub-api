.env
__pycache__/
*.pyc
.venv/
venv/
*.egg-info/
/scratch

# Local QA artefacts. This is a backend repo — it has never tracked a single
# image — but ~55 screenshots, a screen recording and 285 Playwright output
# files piled up at the root during visual verification, plus a stray _site/
# that was an accidental 85-file snapshot of the repo itself. About 20 MB of
# nothing. Rooted patterns (/*.png, not *.png) so a real asset committed in a
# subdirectory would still be tracked.
/*.png
/*.jpg
/*.jpeg
/*.gif
/*.webp
/*.mp4
/.playwright-mcp/
/_site/

# Wrangler local dev. .dev.vars holds REAL secrets when testing a Worker
# locally (INGEST_SECRET, TURNSTILE_SECRET); .wrangler/ is local state.
# Neither belongs in a public repo, and the whole point of `wrangler secret
# put` is that the value never reaches git.
.dev.vars
.dev.vars.*
.wrangler/

# Akinator prototype input: a 1 MB cache of Open Library's search API,
# regenerable in a minute by scripts/akinator/fetch_sample.py. Kept out of
# the repo deliberately — the licence terms on OL's data are still unchecked
# (Phase 1 of the build plan flags it), and untracked scratch input is the
# safe side of that question.
/data/akinator_sample.json

# Akinator corpus: 20k Open Library works, rebuilt monthly by
# scripts/akinator/build_corpus.py. Same reasoning as the sample above —
# OL names no licence for their catalogue data, so we do not redistribute it.
/data/akinator_corpus.jsonl

# Wikidata author harvest — regenerable by scripts/akinator/harvest_authors.py
/data/akinator_authors_wd.json
/data/akinator_authors_wd_asked.json
/data/akinator_build/

# Wikidata author harvest: regenerable by scripts/akinator/harvest_authors.py.
/data/akinator_authors_wd.json
/data/akinator_authors_wd_asked.json

# Wikidata works harvest (screen adaptations + series), regenerable.
/data/akinator_works_wd.json
/data/akinator_works_wd_asked.json

# Protagonist gender cache (Wikipedia pronoun counting), regenerable.
/data/akinator_protagonist.json

# Question-review dump, regenerated on demand for the owner review pass.
/data/akinator_questions_review.json

# Wikidata series names, regenerable by harvest_series_labels.py.
/data/akinator_series_labels.json

# Open Library cover ids, regenerable by fetch_covers.py.
/data/akinator_covers.json

# OL work descriptions for trait extraction, regenerable.
/data/akinator_descriptions.json
/data/akinator_descriptions_asked.json

# Hand-labelled trait batches (input to manual_traits.py ingest).
/data/_labels_batch*.json
/data/akinator_traits.json

# Saved calibration run — the model's own answers on our published pages,
# kept so re-scoring them against changed CALIBRATION_HINTS costs nothing.
# Regenerable by scripts/akinator/extract_traits.py --calibrate, but that
# is 129 calls of a 15-a-minute quota, so it is worth not deleting.
/data/akinator_calibration.json

# Fandom wiki resolution (harvest_fandom.py) and its proof under the
# redesign's acceptance rules (prove_fandom.py). Both regenerable, but the
# proof costs ~180 API calls across 29 wikis and is network-flaky, so it is
# worth not deleting. The FINDINGS live in the vault, not here — this file
# is evidence you can re-derive, not the decision it supports.
/data/akinator_fandom.json
/data/akinator_fandom_proof.json

# Author lookups by name for the ones P648 could not reach, regenerable
# by scripts/akinator/harvest_authors_bysearch.py (resumable — re-running
# retries only the entries left UNAVAILABLE).
/data/akinator_authors_search.json

# Wikidata country QID -> English name, cached by
# harvest_authors_bysearch.py so stable labels are not re-fetched.
/data/akinator_country_labels.json

# Fandom discovery run output (scripts/akinator/discover_fandom.py) --
# audit trail of every candidate tried per title. Regenerable.
/data/akinator_fandom_discovery.json

# Fandom-wide wiki census (community-maintained Module:WikiData
# cache + Books_hub cross-reference + novel classification).
# Regenerable by scripts/akinator/census_fandom_novels.py.
/data/fandom_wikidata_module.json
/data/fandom_novel_census.csv
/data/fandom_novel_census.json

# Cast harvested from the census's novel wikis, ranked by article length
# (scripts/akinator/harvest_fandom_characters.py). Regenerable; the Open
# Library `person` field's counterpart for books that catalogue misses.
/data/akinator_fandom_characters.json

# Verified prose per novel wiki, the input traits.py needs and Open
# Library cannot supply for web novels
# (scripts/akinator/harvest_fandom_text.py). Regenerable.
/data/akinator_fandom_text.json

# Trait labels for those books (extract_traits.py --source fandom). Kept
# apart from akinator_traits.json because the two are keyed differently:
# Open Library rows by /works/OL…W, these by title. Regenerable.
/data/akinator_fandom_traits.json
