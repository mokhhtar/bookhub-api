.env
__pycache__/
*.pyc
.venv/
venv/
*.egg-info/
/scratch

# Local QA artefacts. This is a backend repo — it has never tracked a single
# image — but ~55 screenshots, a screen recording and 285 Playwright output
# files piled up at the root during visual verification, plus a stray _site/
# that was an accidental 85-file snapshot of the repo itself. About 20 MB of
# nothing. Rooted patterns (/*.png, not *.png) so a real asset committed in a
# subdirectory would still be tracked.
/*.png
/*.jpg
/*.jpeg
/*.gif
/*.webp
/*.mp4
/.playwright-mcp/
/_site/

# Wrangler local dev. .dev.vars holds REAL secrets when testing a Worker
# locally (INGEST_SECRET, TURNSTILE_SECRET); .wrangler/ is local state.
# Neither belongs in a public repo, and the whole point of `wrangler secret
# put` is that the value never reaches git.
.dev.vars
.dev.vars.*
.wrangler/

# Akinator prototype input: a 1 MB cache of Open Library's search API,
# regenerable in a minute by scripts/akinator/fetch_sample.py. Kept out of
# the repo deliberately — the licence terms on OL's data are still unchecked
# (Phase 1 of the build plan flags it), and untracked scratch input is the
# safe side of that question.
/data/akinator_sample.json

# Akinator corpus: 20k Open Library works, rebuilt monthly by
# scripts/akinator/build_corpus.py. Same reasoning as the sample above —
# OL names no licence for their catalogue data, so we do not redistribute it.
/data/akinator_corpus.jsonl

# Wikidata author harvest — regenerable by scripts/akinator/harvest_authors.py
/data/akinator_authors_wd.json
/data/akinator_authors_wd_asked.json
/data/akinator_build/

# Wikidata author harvest: regenerable by scripts/akinator/harvest_authors.py.
/data/akinator_authors_wd.json
/data/akinator_authors_wd_asked.json
