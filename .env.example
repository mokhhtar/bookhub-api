GEMINI_API_KEY=your_gemini_api_key_here
GOOGLE_BOOKS_API_KEY=optional_increases_rate_limit
AMAZON_TAG=yourtag-20
ALLOWED_ORIGINS=http://localhost:4000,https://yourusername.github.io

# Upstash Redis (REST) — daily picks + shared response cache
UPSTASH_REDIS_REST_URL=https://your-db.upstash.io
UPSTASH_REDIS_REST_TOKEN=your_upstash_rest_token

# Static SEO page publishing (commits _books/ and _authors/ to the Jekyll repo)
GITHUB_PAT=github_pat_fine_grained_contents_write
GITHUB_REPO=mokhhtar/bookhub
GITHUB_BRANCH=main
GITHUB_PUBLISH_ENABLED=false

# Amazon Creators API Integration (Optional)
AMAZON_CREDENTIAL_ID=amzn1.application-oa2-client.your_client_id_here
AMAZON_CREDENTIAL_SECRET=amzn1.oa2-cs.v1.your_client_secret_here
AMAZON_PARTNER_TAG=oceansidehair-20
